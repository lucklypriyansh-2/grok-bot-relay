# Copy this file to ~/.config/grok-relay/env and fill in real values.
# Then: chmod 600 ~/.config/grok-relay/env
# Never commit the real env file, paste it into chat, or store keys in CLI config.

export GROK_WEBHOOK_URL="https://example.invalid/automations/webhook/YOUR_WEBHOOK_ID"
export GROK_WEBHOOK_KEY="YOUR_WEBHOOK_KEY"

# Optional: used when the CLI and the Grok Bot do not share a filesystem.
# GROK_RELAY_RESULTS_URL is the origin only (no trailing slash, no /results or /tasks suffix).
# The same URL and token are used to upload full tasks (PUT /tasks/<id>) and to read results.
# export GROK_RELAY_RESULTS_URL="https://results.example.invalid"
# export GROK_RELAY_RESULTS_TOKEN="YOUR_RESULTS_TOKEN"
#
# If the origin changes (a Cloudflare quick tunnel URL rotates after a restart),
# point the client at a file the host updates, and it will be re-read on every
# request and retry:
# export GROK_RELAY_RESULTS_URL_FILE="/absolute/path/to/tunnel-url.txt"

# Optional overrides. The results directory defaults to <package>/results.
# The tasks directory defaults to <package>/tasks.
# export GROK_RELAY_RESULTS_DIR="/absolute/path/to/grok-bot-relay/results"
# export GROK_RELAY_TASKS_DIR="/absolute/path/to/grok-bot-relay/tasks"
# export GROK_RELAY_RESULTS_HOST="127.0.0.1"
# export GROK_RELAY_RESULTS_PORT="8787"
